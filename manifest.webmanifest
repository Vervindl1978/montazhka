{
  "name": "Монтажка — відеоредактор",
  "short_name": "Монтажка",
  "description": "Офлайн-відеоредактор із переходами та ефектами, які можна створювати й ділитися ними",
  "lang": "uk",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1216",
